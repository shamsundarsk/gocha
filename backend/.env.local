# Application
APP_NAME=Gocha
APP_ENV=development
SECRET_KEY=dev-secret-key-gocha-2024

# SQLite for local dev (no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./gocha_dev.db
SYNC_DATABASE_URL=sqlite:///./gocha_dev.db

# Redis (optional for dev)
REDIS_URL=redis://localhost:6379/0

# External APIs (optional — demo mode works without these)
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Event Sources (optional)
EVENTBRITE_API_KEY=
TICKETMASTER_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081,http://localhost:19006

# Demo Mode on by default for dev
DEMO_MODE=true
