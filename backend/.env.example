# Application
APP_NAME=Gocha
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gocha_db
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/gocha_db

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=gocha-media

# Event Sources
EVENTBRITE_API_KEY=your_eventbrite_api_key
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# Demo Mode
DEMO_MODE=false
